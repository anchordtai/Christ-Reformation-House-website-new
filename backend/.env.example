# Copy to .env locally or set these in Render → Environment.
# Never commit real secrets.

PORT=5000
NODE_ENV=production

# Where users return after Flutterwave checkout (no trailing slash)
FRONTEND_ORIGIN=https://christreformationhouse.org.ng

# Supabase (Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Flutterwave V4 OAuth (Dashboard → Settings → API)
FLW_CLIENT_ID=your-client-id
FLW_CLIENT_SECRET=your-client-secret

# Flutterwave V4 encryption key (required for card payments)
FLW_ENCRYPTION_KEY=your-base64-encryption-key

# Use sandbox while testing, production when live
# Sandbox:  https://developersandbox-api.flutterwave.com
# Live:     https://f4bexperience.flutterwave.com
FLW_API_BASE_URL=https://developersandbox-api.flutterwave.com

# Optional webhook verification (Dashboard → Webhooks)
FLW_WEBHOOK_SECRET_HASH=your-webhook-secret-hash


# Confirm currency availability in your Flutterwave merchant account.
# Comma-separated allowlist; the giving page reads this configuration.
DONATION_CURRENCIES=NGN,USD,GBP,EUR,GHS,ZAR,KES

# Enable only methods approved for this Flutterwave merchant account.
# Bank transfer, USSD and OPay are restricted to NGN in this implementation.
# Start with card; opt in after sandbox and merchant checks:
# DONATION_PAYMENT_METHODS=card,bank_transfer,ussd,opay
DONATION_PAYMENT_METHODS=card

# Optional supported in-website meetings. No frontend secrets are required.
# Leave unset to retain the working public Jitsi launch option.
# Get App ID, Key ID and the matching RSA private key from https://jaas.8x8.vc/
# JAAS_APP_ID=vpaas-magic-cookie-...
# JAAS_KEY_ID=vpaas-magic-cookie-.../key-id
# JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Only confirmed Supabase users in this server allowlist (or with an admin /
# meeting_host app_metadata claim) can receive host tokens. Never user_metadata.
# MEETING_HOST_USER_IDS=authorized-supabase-user-uuid
